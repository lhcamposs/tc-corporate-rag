spring.application.name=tc-corporate-rag
logging.pattern.console=%green(%d{HH:mm:ss.SSS}) %blue(%-5level) %red([%thread]) %yellow(%logger{15}) - %msg%n

# --- Conexao com o PostgreSQL (rodando no container 'postgres') ---
spring.datasource.url=jdbc:postgresql://localhost:5432/tc_rag_db
spring.datasource.username=USERNAME_AQUI
spring.datasource.password=SENHA_AQUI
spring.datasource.driver-class-name=org.postgresql.Driver

# --- Ollama (embeddings + geracao de texto) ---
spring.ai.ollama.base-url=http://localhost:11434
spring.ai.ollama.chat.model=llama3.2:3b
spring.ai.ollama.embedding.model=nomic-embed-text

# --- HikariCP Configuration ---
spring.datasource.hikari.max-lifetime=600000
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.connection-timeout=20000
spring.datasource.hikari.validation-timeout=5000

# --- Vector store: pgvector ---
spring.ai.vectorstore.pgvector.index-type=HNSW
spring.ai.vectorstore.pgvector.distance-type=COSINE_DISTANCE
spring.ai.vectorstore.pgvector.dimensions=768
spring.ai.vectorstore.pgvector.initialize-schema=true

# --- Vector store: ChromaDB (objetivo c: comparacao pgvector x ChromaDB) ---
# O Chroma sobe por autoconfigure. Ele sobe junto com o app via docker compose.
spring.ai.vectorstore.chroma.client.host=http://localhost
spring.ai.vectorstore.chroma.client.port=8000
spring.ai.vectorstore.chroma.collection-name=tc_corporate_rag
spring.ai.vectorstore.chroma.initialize-schema=true

# --- Os autoconfigures do pgvector e do Chroma NAO podem coexistir (os dois ---
# --- registram um bean 'vectorStore'). Por isso o do pgvector e excluido e o ---
# --- PgVectorStore e montado em config/VectorStoreConfig, lendo as propriedades ---
# --- spring.ai.vectorstore.pgvector.* acima. ---
spring.autoconfigure.exclude=org.springframework.ai.vectorstore.pgvector.autoconfigure.PgVectorStoreAutoConfiguration

# --- Parametros da recuperacao (iguais nos dois bancos, para comparacao justa) ---
rag.top-k=4
rag.similarity-threshold=0.0
# Temperatura 0: geracao deterministica (mesma pergunta + mesmos trechos = mesma resposta)
rag.temperatura=0.0

# --- Integracao com Docker Compose ---
spring.docker.compose.enabled=true

# --- Inicializacao do Banco de Dados ---
spring.sql.init.mode=always
spring.jpa.hibernate.ddl-auto=none

spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

server.port=8080

# DEBUG mostra os prompts, mas distorce os tempos: use INFO durante as medicoes do experimento
logging.level.org.springframework.ai=INFO
